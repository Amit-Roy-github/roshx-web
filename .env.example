# Empty in dev so requests go to /api and Vite proxies them to lal-ju-server.
VITE_API_BASE_URL=/api

# Optional. Defaults to the roshx OAuth client baked into src/shared/lib/env.ts —
# an OAuth client id is public, and Cloud Build never sees a VITE_ var from the
# deploy workflow. Set only to point a fork at a different client.
VITE_GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
